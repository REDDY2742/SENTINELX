# ============================================================
#  SENTINELX — .gitignore
#  Stack: Python (FastAPI) · React + TypeScript + Vite
# ============================================================

# ------------------------------------------------------------------
# ENVIRONMENT & SECRETS  ← Never commit these!
# ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ------------------------------------------------------------------
# PYTHON
# ------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
*.whl
.eggs/

# Unit test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.lcov
.tox/
.nox/

# Type checkers
.mypy_cache/
.pytype/
.pyre/

# Jupyter
.ipynb_checkpoints/

# Python installer logs
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------
# NODE / FRONTEND (React + Vite)
# ------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Vite cache
.vite/

# ------------------------------------------------------------------
# GENERAL BUILD ARTIFACTS
# ------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# ------------------------------------------------------------------
# DATABASE / STORAGE
# ------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.json.lock

# JSON files that are auto-generated / seeded data (not source)
registration_otps.json

# ------------------------------------------------------------------
# CLOUD / AWS
# ------------------------------------------------------------------
.aws/
*.tfstate
*.tfstate.backup
.terraform/

# ------------------------------------------------------------------
# IDE & EDITORS
# ------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Vim / Emacs
*.vim
*~
\#*\#

# ------------------------------------------------------------------
# OS ARTIFACTS
# ------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------------
*.dockerignore

# ------------------------------------------------------------------
# MISC
# ------------------------------------------------------------------
*.zip
*.tar.gz
*.rar
.cache/
